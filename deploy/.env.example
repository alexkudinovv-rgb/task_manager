# Keep the real file ONLY at ~/car-city/.env on the VPS; chmod 600.
APP_DOMAIN=tasks.example.com
PUBLIC_URL=https://tasks.example.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Use the same password as above (hex avoids URL escaping issues).
DATABASE_URL=postgres://tasks:REPLACE_WITH_RANDOM_HEX@postgres:5432/tasks
# Generate once with: openssl rand -base64 32. Preserve across deployments.
TOTP_ENCRYPTION_KEY=REPLACE_WITH_BASE64
FILE_STORAGE=local
# Optional: add VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT.
# For S3 use FILE_STORAGE=s3 and S3_ENDPOINT, S3_REGION, S3_BUCKET,
# S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY. Do not set MCP_DEV_KEY in production.
