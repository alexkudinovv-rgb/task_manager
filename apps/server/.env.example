# Copy to .env for local development. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://tasks:dev@127.0.0.1:5432/tasks
# Where people open the app (Vite dev server locally); invite links are built from it.
PUBLIC_URL=http://localhost:5173
# base64 of 32 random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=
# Web push. Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Task files: local folder in dev; s3 in production (S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY)
FILE_STORAGE=local
FILE_STORAGE_DIR=./storage
# Any 16+ characters; only for the MCP spike.
MCP_DEV_KEY=change-me-local-dev-key
