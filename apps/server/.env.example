# Copy to .env for local development. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://tasks:dev@127.0.0.1:5432/tasks
# Where people open the app (Vite dev server locally); invite links are built from it.
PUBLIC_URL=http://localhost:5173
# base64 of 32 random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=
# Any 16+ characters; only for the MCP spike.
MCP_DEV_KEY=change-me-local-dev-key
